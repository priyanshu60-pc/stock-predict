# --- Clerk (Required) ----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- Supabase (Required) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Finnhub — Free stock data (Required) --------------------------------------
FINNHUB_API_KEY=cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Gemini AI (Required for AI insights) --------------------------------------
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Resend — Email (Required for alerts) --------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cron secret (Required in production) --------------------------------------
# Generate any random string: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# --- AngelOne SmartAPI (Required for Portfolio & Indian market data) ------------
# Get your API key from: https://smartapi.angelone.in/
ANGEL_API_KEY=your_angelone_api_key
# Your AngelOne login Client Code (e.g. A123456)
ANGEL_CLIENT_ID=your_client_code
# Your 4-digit MPIN (used to log in to AngelOne)
ANGEL_MPIN=your_mpin
# Base32 TOTP secret — shown once when you enable TOTP on the SmartAPI portal
# https://smartapi.angelone.in/enable-totp
ANGEL_TOTP_SECRET=your_base32_totp_secret
